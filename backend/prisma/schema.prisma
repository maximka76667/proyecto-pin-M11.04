generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  email                      String?                   @unique
  full_name                  String
  avatar_url                 String?
  is_landlord                Boolean
  password_hash              String?
  google_subject             String?                   @unique
  email_verified_at          DateTime?
  user_apartments            UserApartment[]
  landlord_apartments        Apartment[]               @relation("LandlordApartments")
  createdTransactions        Transaction[]             @relation("CreatedTransactions")
  receivedTransactions       Transaction[]             @relation("ReceivedTransactions")
  paidExpenses               Expense[]                 @relation("PaidExpenses")
  paidReceipts               Receipt[]                 @relation("PaidReceipts")
  taskAssignments            TaskAssignment[]
  availability_blocks        AvailabilityBlock[]
  google_calendar_connection GoogleCalendarConnection?
  google_busy_blocks         GoogleBusyBlock[]
  sessions                   AuthSession[]
  password_reset_codes       PasswordResetCode[]
  email_verification_tokens  EmailVerificationToken[]
  swaps_sent                 TaskSwapRequest[]         @relation("SwapFromUser")
  swaps_received             TaskSwapRequest[]         @relation("SwapToUser")
  notifications              Notification[]
  task_points                TaskPoints[]
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  token_hash String   @unique
  user_id    String   @db.Uuid
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model PasswordResetCode {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  code_hash  String
  expires_at DateTime
  attempts   Int      @default(0)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime
  consumed_at DateTime?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model Apartment {
  id              String            @id @default(uuid()) @db.Uuid
  address         String
  name            String
  invite_code     String            @unique @default(uuid()) @db.Uuid
  landlord_id     String?           @db.Uuid
  landlord        User?             @relation("LandlordApartments", fields: [landlord_id], references: [id])
  transactions    Transaction[]
  expenses        Expense[]
  receipts        Receipt[]
  tasks           Task[]
  user_apartments UserApartment[]
  swap_requests   TaskSwapRequest[]
  notifications   Notification[]
  task_points     TaskPoints[]

  @@unique([landlord_id, name])
  @@index([landlord_id])
}

model UserApartment {
  user_id      String    @db.Uuid
  apartment_id String    @db.Uuid
  joined_at    DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@id([user_id, apartment_id])
  @@index([apartment_id])
}

// Un ticket escaneado. `total_amount` es la suma de los totales de sus gastos (productos) y se
// recalcula en la misma transacción cada vez que se edita uno. No se usa para los balances.
// `version` sirve para bloqueo optimista: se incrementa en cada edición del ticket.
model Receipt {
  id           String    @id @default(uuid()) @db.Uuid
  apartment_id String    @db.Uuid
  payer_id     String    @db.Uuid
  total_amount Decimal   @db.Decimal(12, 2)
  date         DateTime  @default(now()) @db.Date
  version      Int       @default(1)
  created_at   DateTime  @default(now())
  apartment    Apartment @relation(fields: [apartment_id], references: [id])
  payer        User      @relation("PaidReceipts", fields: [payer_id], references: [id])
  expenses     Expense[]

  @@index([apartment_id, date])
  @@index([payer_id])
}

// Un gasto (un producto de un ticket, un gasto manual o una liquidación). Cada `Transaction`
// es la parte de un compañero que debe. El que paga no tiene fila: `payer_participates` dice
// si también reparte el gasto. Los balances se calculan solo con las `Transaction`.
// `receipt_id` es null para gastos manuales y liquidaciones. `version` es el bloqueo optimista.
model Expense {
  id                 String              @id @default(uuid()) @db.Uuid
  apartment_id       String              @db.Uuid
  payer_id           String              @db.Uuid
  receipt_id         String?             @db.Uuid
  type               ExpenseType         @default(EXPENSE)
  total_amount       Decimal             @db.Decimal(12, 2)
  concept            String?
  category           TransactionCategory
  date               DateTime            @default(now()) @db.Date
  payer_participates Boolean             @default(true)
  version            Int                 @default(1)
  created_at         DateTime            @default(now())
  apartment          Apartment           @relation(fields: [apartment_id], references: [id])
  payer              User                @relation("PaidExpenses", fields: [payer_id], references: [id])
  receipt            Receipt?            @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  @@index([apartment_id, date])
  @@index([payer_id])
  @@index([receipt_id])
}

model Transaction {
  id           String              @id @default(uuid()) @db.Uuid
  expense_id   String              @db.Uuid
  apartment_id String              @db.Uuid
  from_user_id String              @db.Uuid
  to_user_id   String              @db.Uuid
  amount       Decimal             @db.Decimal(12, 2)
  concept      String?
  category     TransactionCategory
  date         DateTime            @default(now()) @db.Date
  created_at   DateTime            @default(now())
  expense      Expense             @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  apartment    Apartment           @relation(fields: [apartment_id], references: [id])
  fromUser     User                @relation("CreatedTransactions", fields: [from_user_id], references: [id])
  toUser       User                @relation("ReceivedTransactions", fields: [to_user_id], references: [id])

  @@index([expense_id])
}

model Task {
  id               String           @id @default(uuid()) @db.Uuid
  apartment_id     String           @db.Uuid
  title            String
  description      String?
  duration_minutes Int              @default(30)
  points           Int              @default(0)
  status           TaskStatus
  category         TaskCategory
  priority         TaskPriority
  frequency        TaskFrequency
  apartment        Apartment        @relation(fields: [apartment_id], references: [id])
  assignments      TaskAssignment[]

  @@unique([apartment_id, title])
}

model TaskAssignment {
  id           String            @id @default(uuid()) @db.Uuid
  task_id      String            @db.Uuid
  user_id      String            @db.Uuid
  status       AssignmentStatus
  due_date     DateTime          @db.Date
  start_minute Int               @default(540)
  due_time     String?           @db.VarChar(5)
  task         Task              @relation(fields: [task_id], references: [id])
  user         User              @relation(fields: [user_id], references: [id])
  swap_as_from  TaskSwapRequest[] @relation("SwapFromAssignment")
  swap_as_to    TaskSwapRequest[] @relation("SwapToAssignment")
  notifications Notification[]
  points_entry  TaskPoints?

  @@unique([user_id, due_date, due_time])
}

// Ledger de reputación: una fila por asignación que dio puntos. Los puntos de un usuario son
// la suma de sus filas. `points` es una copia del valor de la tarea en el momento de ganarlos,
// así que editar `Task.points` después no cambia lo ya ganado. `month` es "YYYY-MM".
model TaskPoints {
  id            String         @id @default(uuid()) @db.Uuid
  user_id       String         @db.Uuid
  apartment_id  String         @db.Uuid
  assignment_id String         @unique @db.Uuid
  points        Int
  month         String         @db.VarChar(7)
  created_at    DateTime       @default(now())
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  apartment     Apartment      @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  assignment    TaskAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@index([apartment_id, month])
  @@index([user_id, month])
}

// Petición de intercambio dirigida A→B. Las pendientes se pueden aceptar (quedan como
// `completed` para que el emisor vea que se aceptó), rechazar o cancelar (estas se borran).
model TaskSwapRequest {
  id                 String     @id @default(uuid()) @db.Uuid
  apartment_id       String     @db.Uuid
  from_user_id       String     @db.Uuid // emisor (A)
  to_user_id         String     @db.Uuid // receptor (B)
  from_assignment_id String     @db.Uuid // tarea de A
  to_assignment_id   String     @db.Uuid // tarea de B elegida por A
  status             SwapStatus @default(pending)
  created_at         DateTime   @default(now())
  resolved_at        DateTime?

  apartment       Apartment      @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  from_user       User           @relation("SwapFromUser", fields: [from_user_id], references: [id])
  to_user         User           @relation("SwapToUser", fields: [to_user_id], references: [id])
  from_assignment TaskAssignment @relation("SwapFromAssignment", fields: [from_assignment_id], references: [id], onDelete: Cascade)
  to_assignment   TaskAssignment @relation("SwapToAssignment", fields: [to_assignment_id], references: [id], onDelete: Cascade)

  @@index([to_user_id])
  @@index([from_user_id])
  @@index([apartment_id])
}

enum SwapStatus {
  pending
  completed
}

// Aviso de un usuario sobre las tareas (UT1019) o los gastos (UT1018) de un piso. Se guarda
// cuando ocurre el evento (asignación, petición o respuesta de intercambio, gasto nuevo, editado
// o borrado, pago marcado, confirmado o rechazado); el recordatorio de vencimiento se crea al
// consultar los avisos.
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  user_id       String           @db.Uuid // destinatario
  apartment_id  String           @db.Uuid
  type          NotificationType
  title         String
  body          String
  // Lo que abre la app al tocar el aviso: la tarea, la petición de intercambio o el movimiento
  // de dinero (Transaction), según `type`. Sin FK: el aviso de un gasto borrado o de un pago
  // rechazado sobrevive a la fila de la que habla
  reference_id  String?          @db.Uuid
  // Asignación de la que habla un aviso de tarea. Con la restricción única impide repetir el
  // mismo recordatorio; los avisos de intercambio no la llevan
  assignment_id String?          @db.Uuid
  is_read       Boolean          @default(false)
  created_at    DateTime         @default(now())

  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  apartment  Apartment       @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  assignment TaskAssignment? @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type, assignment_id])
  @@index([user_id, apartment_id, created_at])
}

enum NotificationType {
  task_assigned
  task_due_soon
  swap_requested
  swap_accepted
  swap_rejected
  // Gastos (UT1018)
  expense_added
  expense_updated
  expense_deleted
  payment_marked
  payment_confirmed
  payment_rejected
}

model GoogleCalendarConnection {
  user_id       String   @id @db.Uuid
  refresh_token String
  calendar_id   String   @default("primary")
  connected_at  DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Titles are visible only to the owner; descriptions are never retained.
model GoogleBusyBlock {
  id         String   @id
  user_id    String   @db.Uuid
  event_date DateTime @db.Date
  start_at   DateTime
  end_at     DateTime
  title      String?
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, event_date])
}

enum ExpenseType {
  EXPENSE
  SETTLEMENT
}

enum TransactionCategory {
  utilities
  maintenance
  supplies
  entertainment
  payment
  other
  pending
}

enum TaskStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum TaskCategory {
  cleaning
  maintenance
  shopping
  other
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskFrequency {
  none
  daily
  weekly
  biweekly
  monthly
}

enum AssignmentStatus {
  pending
  accepted
  rejected
  completed
  overdue
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// Franja semanal en la que un usuario está ocupado. Los minutos cuentan desde las 00:00 (0-1440)
model AvailabilityBlock {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  day_of_week  DayOfWeek
  start_minute Int
  end_minute   Int
  label        String?
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, day_of_week])
}
