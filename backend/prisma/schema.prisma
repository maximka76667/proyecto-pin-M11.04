generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  email                      String?                   @unique
  full_name                  String
  avatar_url                 String?
  is_landlord                Boolean
  password_hash              String?
  google_subject             String?                   @unique
  email_verified_at          DateTime?
  user_apartments            UserApartment[]
  landlord_apartments        Apartment[]               @relation("LandlordApartments")
  createdTransactions        Transaction[]             @relation("CreatedTransactions")
  receivedTransactions       Transaction[]             @relation("ReceivedTransactions")
  taskAssignments            TaskAssignment[]
  availability_blocks        AvailabilityBlock[]
  google_calendar_connection GoogleCalendarConnection?
  google_busy_blocks         GoogleBusyBlock[]
  sessions                   AuthSession[]
  password_reset_codes       PasswordResetCode[]
  email_verification_tokens  EmailVerificationToken[]
  swaps_sent                 TaskSwapRequest[]         @relation("SwapFromUser")
  swaps_received             TaskSwapRequest[]         @relation("SwapToUser")
  task_points                TaskPoints[]
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  token_hash String   @unique
  user_id    String   @db.Uuid
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model PasswordResetCode {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  code_hash  String
  expires_at DateTime
  attempts   Int      @default(0)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime
  consumed_at DateTime?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model Apartment {
  id              String            @id @default(uuid()) @db.Uuid
  address         String
  name            String
  invite_code     String            @unique @default(uuid()) @db.Uuid
  landlord_id     String?           @db.Uuid
  landlord        User?             @relation("LandlordApartments", fields: [landlord_id], references: [id])
  transactions    Transaction[]
  tasks           Task[]
  user_apartments UserApartment[]
  swap_requests   TaskSwapRequest[]
  task_points     TaskPoints[]

  @@unique([landlord_id, name])
  @@index([landlord_id])
}

model UserApartment {
  user_id      String    @db.Uuid
  apartment_id String    @db.Uuid
  joined_at    DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@id([user_id, apartment_id])
  @@index([apartment_id])
}

model Transaction {
  id           String              @id @default(uuid()) @db.Uuid
  apartment_id String              @db.Uuid
  from_user_id String              @db.Uuid
  to_user_id   String              @db.Uuid
  amount       Decimal             @db.Decimal(12, 2)
  concept      String?
  category     TransactionCategory
  date         DateTime            @default(now()) @db.Date
  created_at   DateTime            @default(now())
  apartment    Apartment           @relation(fields: [apartment_id], references: [id])
  fromUser     User                @relation("CreatedTransactions", fields: [from_user_id], references: [id])
  toUser       User                @relation("ReceivedTransactions", fields: [to_user_id], references: [id])
}

model Task {
  id               String           @id @default(uuid()) @db.Uuid
  apartment_id     String           @db.Uuid
  title            String
  description      String?
  duration_minutes Int              @default(30)
  points           Int              @default(0)
  status           TaskStatus
  category         TaskCategory
  priority         TaskPriority
  frequency        TaskFrequency
  apartment        Apartment        @relation(fields: [apartment_id], references: [id])
  assignments      TaskAssignment[]

  @@unique([apartment_id, title])
}

model TaskAssignment {
  id           String            @id @default(uuid()) @db.Uuid
  task_id      String            @db.Uuid
  user_id      String            @db.Uuid
  status       AssignmentStatus
  due_date     DateTime          @db.Date
  start_minute Int               @default(540)
  due_time     String?           @db.VarChar(5)
  task         Task              @relation(fields: [task_id], references: [id])
  user         User              @relation(fields: [user_id], references: [id])
  swap_as_from TaskSwapRequest[] @relation("SwapFromAssignment")
  swap_as_to   TaskSwapRequest[] @relation("SwapToAssignment")
  points_entry TaskPoints?

  @@unique([user_id, due_date, due_time])
}

// Ledger de reputación: una fila por asignación que dio puntos. Los puntos de un usuario son
// la suma de sus filas. `points` es una copia del valor de la tarea en el momento de ganarlos,
// así que editar `Task.points` después no cambia lo ya ganado. `month` es "YYYY-MM".
model TaskPoints {
  id            String         @id @default(uuid()) @db.Uuid
  user_id       String         @db.Uuid
  apartment_id  String         @db.Uuid
  assignment_id String         @unique @db.Uuid
  points        Int
  month         String         @db.VarChar(7)
  created_at    DateTime       @default(now())
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  apartment     Apartment      @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  assignment    TaskAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@index([apartment_id, month])
  @@index([user_id, month])
}

// Petición de intercambio dirigida A→B. Las pendientes se pueden aceptar (quedan como
// `completed` para que el emisor vea que se aceptó), rechazar o cancelar (estas se borran).
model TaskSwapRequest {
  id                 String     @id @default(uuid()) @db.Uuid
  apartment_id       String     @db.Uuid
  from_user_id       String     @db.Uuid // emisor (A)
  to_user_id         String     @db.Uuid // receptor (B)
  from_assignment_id String     @db.Uuid // tarea de A
  to_assignment_id   String     @db.Uuid // tarea de B elegida por A
  status             SwapStatus @default(pending)
  created_at         DateTime   @default(now())
  resolved_at        DateTime?

  apartment       Apartment      @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  from_user       User           @relation("SwapFromUser", fields: [from_user_id], references: [id])
  to_user         User           @relation("SwapToUser", fields: [to_user_id], references: [id])
  from_assignment TaskAssignment @relation("SwapFromAssignment", fields: [from_assignment_id], references: [id], onDelete: Cascade)
  to_assignment   TaskAssignment @relation("SwapToAssignment", fields: [to_assignment_id], references: [id], onDelete: Cascade)

  @@index([to_user_id])
  @@index([from_user_id])
  @@index([apartment_id])
}

enum SwapStatus {
  pending
  completed
}

model GoogleCalendarConnection {
  user_id       String   @id @db.Uuid
  refresh_token String
  calendar_id   String   @default("primary")
  connected_at  DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Titles are visible only to the owner; descriptions are never retained.
model GoogleBusyBlock {
  id         String   @id
  user_id    String   @db.Uuid
  event_date DateTime @db.Date
  start_at   DateTime
  end_at     DateTime
  title      String?
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, event_date])
}

enum TransactionCategory {
  utilities
  maintenance
  supplies
  entertainment
  payment
  other
  pending
}

enum TaskStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum TaskCategory {
  cleaning
  maintenance
  shopping
  other
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskFrequency {
  none
  daily
  weekly
  biweekly
  monthly
}

enum AssignmentStatus {
  pending
  accepted
  rejected
  completed
  overdue
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// Franja semanal en la que un usuario está ocupado. Los minutos cuentan desde las 00:00 (0-1440)
model AvailabilityBlock {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  day_of_week  DayOfWeek
  start_minute Int
  end_minute   Int
  label        String?
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, day_of_week])
}
