generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String           @id @default(uuid()) @db.Uuid
  email                String?          @unique
  full_name            String
  is_landlord          Boolean
  user_apartments      UserApartment[]
  landlord_apartments  Apartment[]      @relation("LandlordApartments")
  createdTransactions  Transaction[]    @relation("CreatedTransactions")
  receivedTransactions Transaction[]    @relation("ReceivedTransactions")
  taskAssignments      TaskAssignment[]
  availability_blocks  AvailabilityBlock[]
  google_calendar_connection GoogleCalendarConnection?
  google_busy_blocks    GoogleBusyBlock[]
}

model Apartment {
  id              String          @id @default(uuid()) @db.Uuid
  address         String
  name            String
  invite_code     String          @unique @default(uuid()) @db.Uuid
  landlord_id     String?         @db.Uuid
  landlord        User?           @relation("LandlordApartments", fields: [landlord_id], references: [id])
  transactions    Transaction[]
  tasks           Task[]
  user_apartments UserApartment[]

  @@unique([landlord_id, name])
  @@index([landlord_id])
}

model UserApartment {
  user_id      String    @db.Uuid
  apartment_id String    @db.Uuid
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@id([user_id, apartment_id])
  @@index([apartment_id])
}

model Transaction {
  id           String              @id @default(uuid()) @db.Uuid
  apartment_id String              @db.Uuid
  from_user_id String              @db.Uuid
  to_user_id   String              @db.Uuid
  amount       Decimal             @db.Decimal(12, 2)
  concept      String?
  category     TransactionCategory
  date         DateTime            @default(now()) @db.Date
  created_at   DateTime            @default(now())
  apartment    Apartment           @relation(fields: [apartment_id], references: [id])
  fromUser     User                @relation("CreatedTransactions", fields: [from_user_id], references: [id])
  toUser       User                @relation("ReceivedTransactions", fields: [to_user_id], references: [id])
}

model Task {
  id           String           @id @default(uuid()) @db.Uuid
  apartment_id String           @db.Uuid
  title        String
  description  String?
  status       TaskStatus
  category     TaskCategory
  priority     TaskPriority
  frequency    TaskFrequency
  apartment    Apartment        @relation(fields: [apartment_id], references: [id])
  assignments  TaskAssignment[]

  @@unique([apartment_id, title])
}

model TaskAssignment {
  id       String           @id @default(uuid()) @db.Uuid
  task_id  String           @db.Uuid
  user_id  String           @db.Uuid
  status   AssignmentStatus
  due_date DateTime         @db.Date
  start_minute Int          @default(540)
  task     Task             @relation(fields: [task_id], references: [id])
  user     User             @relation(fields: [user_id], references: [id])
}

model GoogleCalendarConnection {
  user_id       String   @id @db.Uuid
  refresh_token String
  calendar_id   String   @default("primary")
  connected_at  DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Only event boundaries are retained. Google event titles and descriptions are discarded.
model GoogleBusyBlock {
  id          String   @id
  user_id     String   @db.Uuid
  event_date  DateTime @db.Date
  start_at    DateTime
  end_at      DateTime
  title       String?
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, event_date])
}

enum TransactionCategory {
  utilities
  maintenance
  supplies
  entertainment
  payment
  other
  pending
}

enum TaskStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum TaskCategory {
  cleaning
  maintenance
  shopping
  other
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskFrequency {
  none
  daily
  weekly
  biweekly
  monthly
}

enum AssignmentStatus {
  pending
  accepted
  rejected
  completed
  overdue
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// Franja semanal en la que un usuario está ocupado. Los minutos cuentan desde las 00:00 (0-1440)
model AvailabilityBlock {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  day_of_week  DayOfWeek
  start_minute Int
  end_minute   Int
  label        String?
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, day_of_week])
}
